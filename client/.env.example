# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Database (for reference - actual connection handled by API)
DATABASE_URL=postgresql://username:password@your-azure-postgres-server.postgres.database.azure.com:5432/sports_predictions?sslmode=require

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key

# Weather API (optional)
WEATHER_API_KEY=your-weather-api-key

# Sports Data API (optional)
SPORTS_API_KEY=your-sports-api-key