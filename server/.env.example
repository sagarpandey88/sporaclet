# Database Configuration
DATABASE_URL=postgresql://username:password@your-azure-postgres-server.postgres.database.azure.com:5432/sports_predictions?sslmode=require

# Server Configuration
PORT=3001
NODE_ENV=production

# Azure PostgreSQL Configuration (Alternative format)
DB_HOST=your-azure-postgres-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=sports_predictions
DB_USER=username
DB_PASSWORD=password
DB_SSL=true

# AI Configuration
AI_MODEL_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL_NAME=gpt-3.5-turbo
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1000

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_CRON=0 6 * * *
SCHEDULER_TIMEZONE=America/New_York
FETCH_SPORTS_DATA=true
GENERATE_PREDICTIONS=true

# Task Configuration
SPORTS_TO_PROCESS=all
MAX_EVENTS_PER_RUN=20
DAYS_AHEAD=7
REQUEST_DELAY_MS=1000
MAX_CONCURRENT_REQUESTS=3
MAX_RETRIES=3
RETRY_DELAY_MS=5000

# Data Cleanup
CLEANUP_OLD_PREDICTIONS=true
RETENTION_DAYS=90

# External APIs
SPORTS_API_KEY=your-sports-api-key
WEATHER_API_KEY=your-weather-api-key

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Development
RUN_INITIAL_TASK=false